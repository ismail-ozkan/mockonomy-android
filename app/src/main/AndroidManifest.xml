<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to open sockets; the proxy also uses it for outgoing traffic -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MockonomyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mockonomy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Mockonomy.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Automation ADB broadcast receiver. exported=true is required on Android 12+
            for access from the adb shell. It is not a gate by itself: operations are only
            applied while the "automation" setting (AdminApiSettingsStore.enabled) is on
            (off by default).
        -->
        <receiver
            android:name=".automation.AutomationBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mockonomy.automation.ACTIVATE" />
                <action android:name="com.mockonomy.automation.SET_RESPONSE" />
                <action android:name="com.mockonomy.automation.SET_STATE" />
                <action android:name="com.mockonomy.automation.RESET" />
                <action android:name="com.mockonomy.automation.CLEAR_LOGS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
