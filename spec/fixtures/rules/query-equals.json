{
  "meta": {
    "name": "query-equals",
    "description": "When QUERY + EQUALS passes, the response with the rule is served",
    "phase": 2,
    "specRef": "behavior/rules.md"
  },
  "environment": {
    "schemaVersion": 1,
    "id": "env-rules",
    "name": "Rules",
    "port": 8080,
    "prefix": "",
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "routes": [
      {
        "id": "route-1",
        "method": "GET",
        "path": "/users/:id",
        "enabled": true,
        "responses": [
          {
            "id": "resp-404",
            "label": "404",
            "statusCode": 404,
            "headers": [],
            "body": "{\"error\":\"not_found\"}",
            "rulesOperator": "AND",
            "rules": [
              {
                "target": "QUERY",
                "operator": "EQUALS",
                "key": "simulate",
                "value": "missing"
              }
            ]
          },
          {
            "id": "resp-200",
            "label": "200",
            "statusCode": 200,
            "headers": [],
            "body": "{\"ok\":true}",
            "isDefault": true
          }
        ]
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/users/7",
    "query": {
      "simulate": [
        "missing"
      ]
    },
    "headers": {},
    "body": null
  },
  "expectedResponse": {
    "statusCode": 404,
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"error\":\"not_found\"}",
    "latencyMs": 0
  },
  "expectedPathParams": {
    "id": "7"
  }
}
