{
  "meta": {
    "name": "unruled-response-not-candidate",
    "description": "A response without rules does not take part in rule-based selection; the one with rules comes first regardless of order",
    "phase": 2,
    "specRef": "behavior/rules.md"
  },
  "environment": {
    "schemaVersion": 1,
    "id": "env-rules",
    "name": "Rules",
    "port": 8080,
    "prefix": "",
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "routes": [
      {
        "id": "route-1",
        "method": "GET",
        "path": "/ping",
        "enabled": true,
        "responses": [
          {
            "id": "resp-unruled",
            "label": "500",
            "statusCode": 500,
            "headers": [],
            "body": "{\"unruled\":true}"
          },
          {
            "id": "resp-ruled",
            "label": "404",
            "statusCode": 404,
            "headers": [],
            "body": "{\"error\":\"not_found\"}",
            "rulesOperator": "AND",
            "rules": [
              {
                "target": "QUERY",
