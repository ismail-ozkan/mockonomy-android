                "key": "simulate"
              }
            ]
          },
          {
            "id": "resp-default",
            "label": "200",
            "statusCode": 200,
            "headers": [],
            "body": "{\"ok\":true}",
            "isDefault": true
          }
        ]
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/ping",
    "query": {
      "simulate": [
        "x"
      ]
    },
    "headers": {},
    "body": null
  },
  "expectedResponse": {
    "statusCode": 404,
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"error\":\"not_found\"}",
    "latencyMs": 0
  }
