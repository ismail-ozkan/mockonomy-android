{
  "meta": {
    "name": "path-param-regex",
    "description": "PATH_PARAM + REGEX matches partially",
    "phase": 2,
    "specRef": "behavior/rules.md"
  },
  "environment": {
    "schemaVersion": 1,
    "id": "env-rules",
    "name": "Rules",
    "port": 8080,
    "prefix": "",
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "routes": [
      {
        "id": "route-1",
        "method": "GET",
        "path": "/users/:id",
        "enabled": true,
        "responses": [
          {
            "id": "resp-numeric",
            "label": "200",
            "statusCode": 200,
            "headers": [],
            "body": "{\"numeric\":true}",
            "rulesOperator": "AND",
            "rules": [
              {
                "target": "PATH_PARAM",
                "operator": "REGEX",
                "key": "id",
                "value": "^[0-9]+$"
              }
            ]
          },
          {
            "id": "resp-other",
            "label": "200",
            "statusCode": 200,
            "headers": [],
            "body": "{\"ok\":true}",
            "isDefault": true
          }
        ]
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/users/42",
    "query": {},
    "headers": {},
    "body": null
  },
  "expectedResponse": {
    "statusCode": 200,
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"numeric\":true}",
    "latencyMs": 0
  },
  "expectedPathParams": {
    "id": "42"
  }
}
