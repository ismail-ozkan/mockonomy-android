{
  "meta": {
    "name": "body-regex",
    "description": "BODY + REGEX is applied to the value read by dot notation",
    "phase": 2,
    "specRef": "behavior/rules.md"
  },
  "environment": {
    "schemaVersion": 1,
    "id": "env-rules",
    "name": "Rules",
    "port": 8080,
    "prefix": "",
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "routes": [
      {
        "id": "route-1",
        "method": "POST",
        "path": "/signup",
        "enabled": true,
        "responses": [
          {
            "id": "resp-hit",
            "label": "200",
            "statusCode": 200,
            "headers": [],
            "body": "{\"hit\":true}",
            "rulesOperator": "AND",
            "rules": [
              {
                "target": "BODY",
                "operator": "REGEX",
                "key": "user.email",
                "value": "@example\\.com$"
              }
            ]
          },
          {
            "id": "resp-default",
            "label": "200",
            "statusCode": 200,
            "headers": [],
            "body": "{\"ok\":true}",
            "isDefault": true
          }
        ]
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/signup",
    "query": {},
    "headers": {},
    "body": "{\"user\":{\"email\":\"ada@example.com\"}}"
  },
  "expectedResponse": {
    "statusCode": 200,
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"hit\":true}",
    "latencyMs": 0
  }
}
