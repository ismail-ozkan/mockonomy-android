{
  "meta": {
    "name": "no-recursion",
    "description": "Helper output is not scanned again — request data cannot run templates",
    "phase": 2,
    "specRef": "behavior/templating.md"
  },
  "environment": {
    "schemaVersion": 1,
    "id": "env-tpl",
    "name": "Templating",
    "port": 8080,
    "prefix": "",
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "routes": [
      {
        "id": "route-1",
        "method": "GET",
        "path": "/echo",
        "enabled": true,
        "responses": [
          {
            "id": "resp-1",
            "label": "200 – ok",
            "statusCode": 200,
            "headers": [],
            "body": "{\"q\":\"{{query.q}}\"}",
            "isDefault": true
          }
        ]
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/echo",
    "query": {
      "q": [
        "{{uuid}}"
      ]
    },
    "headers": {},
    "body": null
  },
  "expectedResponse": {
    "statusCode": 200,
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"q\":\"{{uuid}}\"}",
    "latencyMs": 0
  }
}
