<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
            specialUse is the only suitable type without a time limit; dataSync and
            mediaProcessing are limited to 6 hours per 24 hours.
            The <property> element is required for specialUse and is read during Play review.
        -->
        <service
            android:name=".MockServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local HTTP mock server bound to loopback, serving mock API responses to another app on the same device during development and QA testing. Started and stopped explicitly by the user." />
        </service>
    </application>

</manifest>
